    const canvas = document.getElementById('sparklesCanvas');
    const ctx = canvas.getContext('2d');
    let particles = [];
    let enableSparkles = true;

    function resizeCanvas() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    class Sparkle {
      constructor() {
        this.reset();
      }
      reset() {
        this.x = Math.random() * canvas.width;
        this.y = Math.random() * canvas.height;
        this.size = Math.random() * 2.2 + 0.8;
        this.speedX = (Math.random() - 0.5) * 0.4;
        this.speedY = (Math.random() - 0.5) * 0.4 - 0.2;
        this.opacity = Math.random() * 0.6 + 0.2;
        this.pulse = Math.random() * 0.04 + 0.01;
        // Iridescent color set (Cyan, Pink, Soft Gold, Ice Blue)
        const colors = [
          'rgba(0, 212, 255, ',
          'rgba(255, 42, 95, ',
          'rgba(255, 149, 0, ',
          'rgba(0, 122, 255, ',
          'rgba(121, 40, 202, '
        ];
        this.color = colors[Math.floor(Math.random() * colors.length)];
      }
      update() {
        this.x += this.speedX;
        this.y += this.speedY;
        this.opacity += Math.sin(Date.now() * 0.003) * 0.01;

        if (this.y < -10 || this.x < -10 || this.x > canvas.width + 10) {
          this.reset();
          this.y = canvas.height + 5;
        }
      }
      draw() {
        ctx.beginPath();
        ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
        ctx.fillStyle = this.color + Math.max(0.1, Math.min(1, this.opacity)) + ')';
        ctx.shadowBlur = 8;
        ctx.shadowColor = this.color + '0.5)';
        ctx.fill();
      }
    }

    function initSparkles() {
      const count = window.innerWidth < 640 ? 25 : 55;
      particles = [];
      for (let i = 0; i < count; i++) {
        particles.push(new Sparkle());
      }
    }
    initSparkles();

    function animateSparkles() {
      if (enableSparkles) {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        particles.forEach(p => {
          p.update();
          p.draw();
        });
      }
      requestAnimationFrame(animateSparkles);
    }
    requestAnimationFrame(animateSparkles);

