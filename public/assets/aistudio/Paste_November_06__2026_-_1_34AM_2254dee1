      if (sender === "user") {
        msgDiv.className = "flex justify-end";
        msgDiv.innerHTML = `
          <div class="bg-gradient-to-r from-blue-600 to-cyan-500 text-white p-3.5 rounded-2xl rounded-tr-sm max-w-[85%] shadow-md">
            <p class="leading-relaxed">${escapeHtml(text)}</p>
          </div>
        `;
      } else {
        msgDiv.className = "flex items-start gap-2.5";
        
        let actionBtnHtml = "";
        if (showQuoteAction) {
          actionBtnHtml = `
            <div class="mt-3 pt-2.5 border-t border-slate-200/60 flex items-center gap-2">
              <button onclick="navigateTo('cotizador'); closeChatbotModal();" class="px-3 py-1.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-500 text-white font-bold text-xs shadow-sm hover:opacity-95 transition">
                ⚡ Abrir Cotizador
              </button>
              <button onclick="openQuickWhatsAppQuote();" class="px-3 py-1.5 rounded-xl bg-emerald-600 text-white font-bold text-xs shadow-sm hover:bg-emerald-700 transition">
                💬 Hablar por WhatsApp
              </button>
            </div>
          `;
        }

        msgDiv.innerHTML = `
          <div class="w-7 h-7 rounded-xl bg-gradient-to-tr from-cyan-500 to-rose-500 text-white flex items-center justify-center shrink-0 text-xs font-bold shadow-sm">
            AS
          </div>
