    function importDatabaseJSON(event) {
      const file = event.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const imported = JSON.parse(e.target.result);
          if (imported.config && imported.products && imported.gallery) {
            appData = imported;
            persistDatabase();
            openAdminDashboard();
            applyBrandSettings();
            renderCatalog();
            renderGallery();
            triggerToast("Datos Restaurados", "Tu catálogo y ajustes fueron cargados con éxito.");
