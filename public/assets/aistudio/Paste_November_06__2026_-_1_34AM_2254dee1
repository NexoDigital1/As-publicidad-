  <style>
    /* ============================================================
       iOS 27 LIQUID GLASS & AMBIENT SPARKLE ENGINE
       ============================================================ */
    :root {
      --sat: env(safe-area-inset-top, 0px);
      --sab: env(safe-area-inset-bottom, 0px);
    }

    body {
      background-color: #fbfdff;
      color: #0c121e;
      -webkit-font-smoothing: antialiased;
      -webkit-tap-highlight-color: transparent;
      overflow-x: hidden;
      font-family: 'Outfit', 'Plus Jakarta Sans', sans-serif;
    }

    /* Ambient radiant mesh with iridescent floating micro-lights */
    .bg-radiant-mesh {
      background: 
        radial-gradient(circle at 12% 18%, rgba(0, 212, 255, 0.15) 0%, transparent 45%),
        radial-gradient(circle at 88% 22%, rgba(255, 42, 95, 0.14) 0%, transparent 48%),
        radial-gradient(circle at 50% 50%, rgba(121, 40, 202, 0.08) 0%, transparent 55%),
        radial-gradient(circle at 20% 82%, rgba(255, 149, 0, 0.12) 0%, transparent 45%),
        radial-gradient(circle at 82% 85%, rgba(0, 122, 255, 0.16) 0%, transparent 50%),
        #fbfdff;
      background-attachment: fixed;
    }

    /* Liquid Glass Cards */
    .liquid-glass {
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(34px) saturate(190%);
      -webkit-backdrop-filter: blur(34px) saturate(190%);
      border: 1px solid rgba(255, 255, 255, 0.85);
      position: relative;
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
      will-change: transform;
    }

    .liquid-glass::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.2) 50%, rgba(0, 212, 255, 0.3) 100%);
      -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
      -webkit-mask-composite: xor;
      mask-composite: exclude;
      pointer-events: none;
    }

    .liquid-glass:hover {
      background: rgba(255, 255, 255, 0.86);
      box-shadow: 0 24px 50px -12px rgba(0, 122, 255, 0.2), 0 0 0 1px rgba(255, 42, 95, 0.2);
    }

    /* 3D Tilt Glare Overlay */
    .card-glare {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      pointer-events: none;
      background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255, 255, 255, 0.7) 0%, transparent 65%);
      opacity: 0;
      transition: opacity 0.3s ease;
      mix-blend-mode: overlay;
    }
    .liquid-glass:hover .card-glare {
      opacity: 1;
    }

    /* Animated Siri / AS Intelligence Orb */
    .siri-orb {
      background: conic-gradient(from 0deg, #00d4ff, #007aff, #ff2a5f, #ff9500, #7928ca, #00d4ff);
      animation: siriSpin 6s linear infinite;
      filter: blur(14px);
    }
    @keyframes siriSpin {
      0% { transform: rotate(0deg) scale(1); }
      50% { transform: rotate(180deg) scale(1.12); }
      100% { transform: rotate(360deg) scale(1); }
    }

    /* Holographic Shimmer Badge */
    .badge-holo {
      background: linear-gradient(135deg, rgba(0, 122, 255, 0.12), rgba(255, 42, 95, 0.12), rgba(0, 212, 255, 0.15));
      border: 1px solid rgba(255, 255, 255, 0.9);
      position: relative;
      overflow: hidden;
    }
    .badge-holo::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(60deg, transparent, rgba(255, 255, 255, 0.5), transparent);
      transform: rotate(25deg);
      animation: holoShine 4s infinite ease-in-out;
    }
    @keyframes holoShine {
      0%, 100% { transform: translateX(-120%) rotate(25deg); }
      50% { transform: translateX(120%) rotate(25deg); }
    }

    /* Spring physics tap feedback */
    .btn-spring:active {
      transform: scale(0.94);
      transition: transform 0.12s cubic-bezier(0.3, 2, 0.4, 1);
    }

    /* Canvas background sparkles */
    #sparklesCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    /* Hide scrollbars */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .pb-safe { padding-bottom: calc(6.5rem + var(--sab)); }
    .pt-safe { padding-top: calc(1.5rem + var(--sat)); }
  </style>
