      const img = document.getElementById("editProductImgUrl").value.trim() || "https://placehold.co/600x400/080c16/ffffff?text=" + encodeURIComponent(name);

      if (id) {
        const index = appData.products.findIndex(p => p.id === id);
        if (index !== -1) {
          appData.products[index] = { ...appData.products[index], name, category, price, desc, badge, img };
